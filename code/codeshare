import random
import time
import ctypes

ERROR_MESSAGES = [
    "Hoy, magbayad ka na ng utang mo!",
    "May balance ka pa sa utang mo!",
    "ERROR: Kulang ka sa tulog at pagmamahal.",
    "WARNING: Nag-ooverheat na CPU mo.",
    "404: Utang na loob, bayaran mo na!"
]

def show_error():
    message = random.choice(ERROR_MESSAGES)

    ctypes.windll.user32.MessageBoxW(
        0,
        message,
        "Fake Windows Error - Prank Demo",
        0x30
    )

def main():
    print("Starting fake error demonstration...")
    print("Close each popup to continue.")

    for i in range(5):
        show_error()
        time.sleep(0.5)

    print("Demo finished!")

if __name__ == "__main__":
    main()


